{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "DuoFit Design Tokens · W3C Community Group Format · v2.0",

  "color": {
    "base": {
      "black": {
        "$value": "#050505",
        "$type": "color",
        "$description": "Void Black — primary background across the app"
      },
      "off-white": {
        "$value": "#F5F5F5",
        "$type": "color",
        "$description": "Off-White — primary text color, never pure #fff"
      }
    },
    "brand": {
      "magenta": {
        "$value": "#FF00A8",
        "$type": "color",
        "$description": "Signal Magenta — primary brand color for all actions"
      },
      "cyan": {
        "$value": "#00E5FF",
        "$type": "color",
        "$description": "Volt Cyan — accent, reserved for Streak and Check-in success"
      }
    },
    "neutral": {
      "surface": {
        "$value": "#0D0D0D",
        "$type": "color",
        "$description": "Card surfaces, hover states"
      },
      "line": {
        "$value": "#1A1A1A",
        "$type": "color",
        "$description": "Hairline borders and dividers"
      },
      "muted": {
        "$value": "#A8A8A8",
        "$type": "color",
        "$description": "Secondary text, timestamps, disabled states — WCAG AA compliant (4.5:1 on #050505)"
      },
      "concrete": {
        "$value": "#3A3A3A",
        "$type": "color",
        "$description": "Between line and muted — icons in inactive state"
      }
    },
    "semantic": {
      "background": { "$value": "{color.base.black}", "$type": "color" },
      "surface": { "$value": "{color.neutral.surface}", "$type": "color" },
      "border": { "$value": "{color.neutral.line}", "$type": "color" },
      "text-primary": { "$value": "{color.base.off-white}", "$type": "color" },
      "text-muted": { "$value": "{color.neutral.muted}", "$type": "color" },
      "action-primary": { "$value": "{color.brand.magenta}", "$type": "color" },
      "action-success": { "$value": "{color.brand.cyan}", "$type": "color" },
      "action-error": { "$value": "{color.brand.magenta}", "$type": "color" },
      "streak": { "$value": "{color.brand.cyan}", "$type": "color" }
    }
  },

  "font": {
    "family": {
      "display": {
        "$value": ["Anton", "Impact", "Arial Narrow", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Latin only — wordmark, Streak/stat numbers, short English microcopy. No Hebrew glyphs."
      },
      "display-hebrew": {
        "$value": ["Heebo", "Arial Hebrew", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Hebrew headings (weight 800-900). Anton has no Hebrew glyphs, so every H1/H2 containing Hebrew text uses this instead."
      },
      "body": {
        "$value": ["Space Grotesk", "system-ui", "-apple-system", "sans-serif"],
        "$type": "fontFamily",
        "$description": "UI text, labels, names"
      },
      "mono": {
        "$value": ["JetBrains Mono", "Courier New", "monospace"],
        "$type": "fontFamily",
        "$description": "Metadata, timestamps, eyebrows"
      }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "xs":   { "$value": "10px", "$type": "dimension" },
      "sm":   { "$value": "12px", "$type": "dimension" },
      "base": { "$value": "14px", "$type": "dimension" },
      "lg":   { "$value": "16px", "$type": "dimension" },
      "xl":   { "$value": "20px", "$type": "dimension" },
      "2xl":  { "$value": "28px", "$type": "dimension" },
      "3xl":  { "$value": "44px", "$type": "dimension" },
      "hero": { "$value": "108px", "$type": "dimension", "$description": "Streak number — largest element" }
    },
    "line-height": {
      "tight": { "$value": 1.1, "$type": "number" },
      "normal": { "$value": 1.5, "$type": "number" },
      "relaxed": { "$value": 1.6, "$type": "number" }
    },
    "letter-spacing": {
      "tight": { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0", "$type": "dimension" },
      "wide": { "$value": "0.05em", "$type": "dimension" },
      "wider": { "$value": "0.15em", "$type": "dimension" },
      "widest": { "$value": "0.28em", "$type": "dimension" }
    }
  },

  "space": {
    "0": { "$value": "0px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "24px", "$type": "dimension" },
    "6": { "$value": "32px", "$type": "dimension" },
    "7": { "$value": "48px", "$type": "dimension" },
    "8": { "$value": "64px", "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0px", "$type": "dimension" },
    "sm":   { "$value": "4px", "$type": "dimension" },
    "md":   { "$value": "8px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension", "$description": "Only for avatars" }
  },

  "border": {
    "hairline": {
      "$type": "border",
      "$value": {
        "width": "1px",
        "style": "solid",
        "color": "{color.neutral.line}"
      }
    },
    "focus": {
      "$type": "border",
      "$value": {
        "width": "2px",
        "style": "solid",
        "color": "{color.brand.cyan}"
      }
    }
  },

  "shadow": {
    "none": { "$value": "none", "$type": "shadow" },
    "streak-glow": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "24px",
        "spread": "-4px",
        "color": "rgba(0, 229, 255, 0.4)"
      }
    },
    "magenta-glow": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-8px",
        "color": "rgba(255, 0, 168, 0.4)"
      }
    }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "0ms", "$type": "duration" },
      "fast": { "$value": "150ms", "$type": "duration" },
      "base": { "$value": "300ms", "$type": "duration" },
      "slow": { "$value": "500ms", "$type": "duration" },
      "streak-celebration": { "$value": "1200ms", "$type": "duration" },
      "splash": { "$value": "800ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0, 1)", "$type": "cubicBezier" },
      "accelerate": { "$value": "cubic-bezier(0.3, 0, 1, 1)", "$type": "cubicBezier" },
      "sharp": { "$value": "cubic-bezier(0.4, 0, 0.6, 1)", "$type": "cubicBezier" }
    }
  },

  "size": {
    "touch-target": {
      "$value": "44px",
      "$type": "dimension",
      "$description": "WCAG AAA minimum for touch"
    },
    "icon": {
      "sm": { "$value": "16px", "$type": "dimension" },
      "md": { "$value": "20px", "$type": "dimension" },
      "lg": { "$value": "24px", "$type": "dimension" },
      "xl": { "$value": "32px", "$type": "dimension" }
    },
    "avatar": {
      "xs": { "$value": "32px", "$type": "dimension" },
      "sm": { "$value": "40px", "$type": "dimension" },
      "md": { "$value": "48px", "$type": "dimension" },
      "lg": { "$value": "60px", "$type": "dimension" },
      "xl": { "$value": "96px", "$type": "dimension" }
    }
  },

  "z-index": {
    "base": { "$value": 0, "$type": "number" },
    "sticky": { "$value": 10, "$type": "number" },
    "overlay": { "$value": 100, "$type": "number" },
    "modal": { "$value": 200, "$type": "number" },
    "toast": { "$value": 300, "$type": "number" }
  },

  "opacity": {
    "0": { "$value": 0, "$type": "number" },
    "20": { "$value": 0.2, "$type": "number" },
    "40": { "$value": 0.4, "$type": "number" },
    "60": { "$value": 0.6, "$type": "number" },
    "80": { "$value": 0.8, "$type": "number" },
    "100": { "$value": 1, "$type": "number" },
    "disabled": { "$value": 0.4, "$type": "number" }
  }
}
