# DuoFit Environment Variables

# API Configuration
EXPO_PUBLIC_API_URL=https://api.duofit.example.com
EXPO_PUBLIC_SOCKET_URL=wss://socket.duofit.example.com

# Supabase (Auth + database). Project settings -> API: URL and the publishable key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# PostHog Analytics
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Demo mode: show invented partners, posts, groups, chats (design demos only)
# EXPO_PUBLIC_DEMO_DATA=true
