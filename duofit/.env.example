# DuoFit environment variables. Copy to .env.local (git-ignored) and fill in. Public keys only.

# Supabase (sign-in, database, storage). Project settings -> API: the URL and the PUBLISHABLE key.
# Never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog analytics (optional)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Demo mode: show invented partners, posts, groups and chats (design demos only).
# NEVER set this in an EAS, Vercel or store build.
# EXPO_PUBLIC_DEMO_DATA=true
