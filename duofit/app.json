{
  "expo": {
    "name": "DuoFit",
    "slug": "duofit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "duofit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "description": "Fitness Buddy Matching App · Hebrew-First · React Native + Expo",
    "ios": {
      "supportsTablet": false,
      "userInterfaceStyle": "dark",
      "bundleIdentifier": "com.arielk29.duofit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "he",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "userInterfaceStyle": "dark",
      "package": "com.arielk29.duofit",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "כדי לבחור תמונת פרופיל או תמונה לפוסט, DuoFit זקוקה לגישה לתמונות שלך.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DuoFit משתמשת במיקום שלך כדי להציג שותפים ומקומות אימון קרובים אליך.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true,
          "supportedLocales": {
            "ios": ["he"],
            "android": ["he"]
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
