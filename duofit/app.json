{
  "expo": {
    "name": "DuoFit",
    "slug": "duofit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "duofit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "description": "Fitness Buddy Matching App · Hebrew-First · React Native + Expo",
    "ios": {
      "supportsTablet": false,
      "userInterfaceStyle": "dark",
      "bundleIdentifier": "com.arielk29.duofit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "userInterfaceStyle": "dark",
      "package": "com.arielk29.duofit",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "כדי לבחור תמונת פרופיל, DuoFit זקוק לגישה לתמונות שלך."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DuoFit משתמשת במיקום שלך כדי להציג שותפים ומקומות אימון קרובים אליך."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-router",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
